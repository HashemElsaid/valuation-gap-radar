# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/

# Data
# The raw DLD download is large and stays on your machine. The cleaned file in
# data/processed/ is small (under 500 KB) and IS committed, so the deployed
# demo covers every area.
data/raw/*
!data/raw/.gitkeep

# Streamlit secrets (none yet, but never commit them)
.streamlit/secrets.toml

# Local Claude Code settings (the launch config holds machine-specific paths)
.claude/

# OS and editor files
.DS_Store
Thumbs.db
.vscode/
.idea/
